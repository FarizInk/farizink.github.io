# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript generated files (exclude compiled JS from source folders)
src/**/*.js
src/**/*.js.map
# !src/main.js
!src/**/*.d.ts

# Boneyard-generated skeleton registry & bones are committed (not ignored)
!src/bones/**
# ...but never the tsc-compiled registry — it shadows registry.ts in vite dev
# (Vite resolves .js before .ts) and goes stale when bones are re-captured.
src/bones/registry.js
src/bones/registry.js.map

# Keep this pattern specific to avoid excluding important JS files
lib/**/*.js
lib/**/*.js.map
routes/**/*.js
routes/**/*.js.map


.env